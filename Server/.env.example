# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/careermap

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Admin Setup (Initial run only)
ADMIN_INITIAL_EMAIL=admin@careermapsolutions.com
ADMIN_INITIAL_PASSWORD=Admin@123

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_HOURS=1

# Cloudinary (File Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER_NAME=careermap

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=noreply@careermapsolutions.com
CONTACT_EMAIL=admin@careermapsolutions.com # Admin email to receive contact form submissions
